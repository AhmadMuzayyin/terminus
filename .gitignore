/target/

# Sample/real config export dipakai buat testing fitur Import XML
# (lihat crates/core/src/import/securecrt.rs) — isinya hostname/IP
# infrastruktur ASLI, jangan pernah ke-commit.
/config.xml

# Vault lokal (kredensial terenkripsi) — jangan pernah ke-commit,
# meskipun isinya terenkripsi.
*.db
*.db-journal
*.db-wal
*.db-shm

.DS_Store
build

# Backend API (Node.js, lihat backend/DESIGN.md) — dependency terinstal
# & hasil build, JANGAN ikut ke-commit. `.env` isinya secret asli
# (SERVER_MASTER_KEY/JWT_SECRET/kredensial DB) — cuma `.env.example`
# (template tanpa nilai asli) yang boleh ke-commit.
/backend/node_modules/
/backend/dist/
/backend/.env

# Tool packaging pihak ketiga (linuxdeploy/appimagetool) yang
# didownload otomatis oleh `packaging/linux/build-appimage.sh` —
# binary besar, bukan bagian source proyek, jangan ikut ke-commit.
/packaging/linux/tools/