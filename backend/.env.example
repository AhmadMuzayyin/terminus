# Salin file ini jadi `.env` (JANGAN commit `.env` asli — sudah di
# .gitignore) lalu isi nilai sungguhan.

# Koneksi MySQL — format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@127.0.0.1:3306/terminus_backend"

# Port HTTP server ini sendiri.
PORT=4000

# Kunci enkripsi password host (ChaCha20-Poly1305) — WAJIB 32 byte
# random, encode base64. Generate sekali waktu setup pertama kali,
# JANGAN PERNAH diubah setelah ada data (mengubah ini bikin semua
# password host tersimpan tidak bisa didekripsi lagi). Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_MASTER_KEY="ganti-dengan-32-byte-random-base64"

# Kunci tandatangan JWT access token — random string panjang, beda
# dari SERVER_MASTER_KEY di atas.
JWT_SECRET="ganti-dengan-secret-jwt-yang-panjang-dan-acak"

# Umur access token (JWT) dalam detik. Default 15 menit.
ACCESS_TOKEN_TTL_SECONDS=900

# Umur refresh token dalam detik. Default 30 hari.
REFRESH_TOKEN_TTL_SECONDS=2592000
