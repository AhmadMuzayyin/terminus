import { ComboBox } from "std-widgets.slint";
import { Tokens } from "../tokens.slint";
import { DialogButton, DialogField } from "./dialogs.slint";
import { ConnectingModel, HostsModel } from "../models.slint";

// Titik-titik loading ("● ● ●" bergantian terang-redup) — indikator
// animasi indeterminate PALING sederhana & PALING kecil resikonya buat
// dibangun murni deklaratif di Slint: cuma butuh `Timer` (elemen
// built-in standar) gonta-ganti properti `int` biasa tiap N ms, TANPA
// trigonometri (`Math.sin`/`cos`, belum pernah dibuktikan ada di API
// publik versi Slint yang dipakai di sini) ATAU conic-gradient (belum
// tentu didukung `background:`). `animate opacity` di tiap titik yang
// bikin transisi terang-redupnya smooth, bukan "loncat" tiba-tiba.
component LoadingDots inherits HorizontalLayout {
    spacing: 8px;
    property <int> phase: 0;

    Timer {
        interval: 350ms;
        running: ConnectingModel.visible;
        triggered => {
            root.phase = root.phase + 1;
            if root.phase >= 3 {
                root.phase = 0;
            }
        }
    }

    for i in 3 : Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Tokens.primary;
        opacity: i == root.phase ? 1.0 : 0.3;
        animate opacity { duration: Tokens.transition-normal; easing: ease-in-out; }
    }
}

// Form kredensial untuk host tersimpan yang belum punya username/
// password. Pilih identity tersimpan ATAU isi manual; identity dikirim
// sebagai id saja — password-nya dibaca Rust langsung dari vault.
component CredentialsPrompt inherits VerticalLayout {
    width: 280px;
    spacing: Tokens.stack-gap;
    // Tanpa ini sisa tinggi dibagi ke elemen tanpa tinggi eksplisit
    // (ComboBox melar jadi kotak besar).
    alignment: start;

    // 0 = "Isi manual", i>0 = `HostsModel.identities[i-1]`.
    property <int> choice: 0;
    property <bool> manual: root.choice <= 0;
    property <string> identity-id: root.manual ? "" : HostsModel.identities[root.choice - 1].id;
    property <bool> can-submit: !root.manual
        || (user-field.value != "" && (pw-field.value != "" || ConnectingModel.has-stored-password));

    function submit() {
        if root.can-submit {
            ConnectingModel.credentials-submitted(user-field.value, pw-field.value, root.identity-id);
        }
    }

    Text {
        text: "Host ini belum punya kredensial lengkap.";
        color: Tokens.on-surface-variant;
        font-family: Tokens.font-body;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if HostsModel.identity-count > 0 : VerticalLayout {
        spacing: 4px;
        alignment: start;
        vertical-stretch: 0;
        Text {
            text: "Identity";
            color: Tokens.on-surface-variant;
            font-family: Tokens.font-body;
            font-size: 12px;
        }
        ComboBox {
            height: 34px;
            model: HostsModel.identity-choice-labels;
            current-index: 0;
            selected(text) => { root.choice = self.current-index; }
        }
    }

    // Field tetap ada (bukan `if`) supaya nilainya tidak hilang waktu
    // bolak-balik pilih identity; disembunyikan saja kalau identity dipakai.
    user-field := DialogField {
        visible: root.manual;
        height: root.manual ? 56px : 0px;
        label-text: "Username";
        placeholder: "mis. root";
        initial-value: ConnectingModel.prompt-username;
        auto-focus: ConnectingModel.prompt-username == "";
        accepted => { root.submit(); }
    }
    pw-field := DialogField {
        visible: root.manual;
        height: root.manual ? 56px : 0px;
        label-text: "Password";
        placeholder: ConnectingModel.has-stored-password ? "(kosongkan = pakai yang tersimpan)" : "";
        is-password: true;
        auto-focus: ConnectingModel.prompt-username != "";
        accepted => { root.submit(); }
    }

    Text {
        text: root.manual
            ? "Username & password ini disimpan ke host supaya tidak ditanya lagi."
            : "Login pakai identity ini; username & password-nya disalin ke host.";
        color: Tokens.outline;
        font-family: Tokens.font-body;
        font-size: 11px;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: Tokens.inline-gap;
        DialogButton {
            label-text: "Batal";
            horizontal-stretch: 1;
            clicked => { ConnectingModel.cancel-requested(); }
        }
        DialogButton {
            label-text: "Connect";
            filled: true;
            enabled: root.can-submit;
            horizontal-stretch: 1;
            clicked => { root.submit(); }
        }
    }
}

// Layar penuh "Connecting" — lihat komentar panjang `ConnectingModel`
// di models.slint soal kenapa SATU komponen ini dipakai ulang oleh
// SEMUA alur connect (SSH/SFTP/Console). Semua elemen yang perlu
// "center" SENGAJA masing-masing dibungkus `HorizontalLayout {
// alignment: center; ... }` sendiri-sendiri (bukan geometri manual
// `x: (parent.width - self.width) / 2` di dalam layout) — anak
// langsung sebuah layout, x/y-nya DIKELOLA layout itu sendiri, binding
// manual di situ diabaikan (pelajaran dari bug nyata yang sama di
// `EmptyHostsNotice`, `page-sftp.slint`).
export component ConnectingView inherits Rectangle {
    background: Tokens.surface;

    VerticalLayout {
        alignment: center;
        spacing: Tokens.gutter-md;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: Tokens.radius-lg;
                background: Tokens.primary-container;
                Text {
                    text: ConnectingModel.avatar-letter;
                    color: Tokens.on-primary;
                    font-family: Tokens.font-headline;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        Text {
            text: ConnectingModel.label;
            color: Tokens.on-surface;
            font-family: Tokens.font-headline;
            font-size: Tokens.text-headline-sm;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: ConnectingModel.subtitle;
            color: Tokens.on-surface-variant;
            font-family: Tokens.font-mono;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }

        Rectangle { height: Tokens.gutter-md; }

        // Host TERSIMPAN yang belum ada password (mis. hasil Import
        // SecureCRT) — minta di sini, LANGSUNG lanjut connect otomatis
        // begitu di-submit (lihat komentar panjang `ConnectingModel
        // .needs-password`, models.slint), gantikan spinner selama
        // menunggu input.
        if ConnectingModel.needs-password : HorizontalLayout {
            alignment: center;
            CredentialsPrompt { }
        }

        if !ConnectingModel.needs-password : VerticalLayout {
            spacing: Tokens.gutter-md;
            HorizontalLayout {
                alignment: center;
                LoadingDots { }
            }

            Text {
                text: "Menghubungkan...";
                color: Tokens.on-surface-variant;
                font-family: Tokens.font-body;
                font-size: 12px;
                horizontal-alignment: center;
            }

            Rectangle { height: Tokens.gutter-md; }

            HorizontalLayout {
                alignment: center;
                DialogButton {
                    label-text: "Batal";
                    width: 120px;
                    clicked => { ConnectingModel.cancel-requested(); }
                }
            }
        }
    }
}
