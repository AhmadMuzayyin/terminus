import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../tokens.slint";
import { ConsoleModel } from "../models.slint";
import { TerminalRowView } from "./terminal-view.slint";

// Area terminal interaktif buat sesi Console (serial) — pola SAMA
// PERSIS dengan `TerminalView` (`terminal-view.slint`, tab SSH),
// termasuk pemetaan tombol khusus (Enter/Backspace/panah/Ctrl+huruf)
// jadi byte control yang benar dan TIDAK ada local echo. Duplikasi
// SENGAJA dipertahankan terpisah dari `TerminalView` (bukan diparam-
// eterisasi satu komponen buat dua-duanya) — beda global yang dituju
// (`ConsoleModel` vs `TerminalTabsModel`) bikin parameterisasi Slint
// (tidak bisa oper "global" sebagai argumen) lebih ribet daripada
// manfaatnya, padahal isinya cuma ~40 baris. `TerminalRowView` (murni
// presentational, render SATU baris) tetap di-REUSE apa adanya dari
// `terminal-view.slint`, cuma bagian yang beda (keyboard mapping +
// global mana yang dibaca) yang dobel.
export component ConsoleView inherits Rectangle {
    // SENGAJA BUKAN `TerminalTabsModel.terminal-bg-color` (itu punya
    // tab SSH, ganti-ganti tiap pindah host — lihat `switch_to_tab` di
    // state.rs) — dulu ke-reuse dari situ, akibatnya begitu user ganti
    // tema di SATU tab SSH, background Console ikut kebawa berubah
    // juga (laporan user: "tema nya tidak boleh campur... harus punya
    // tema sendiri sendiri"). Console TIDAK punya UI ganti tema sama
    // sekali (selalu render pakai `terminus_dark()`, lihat
    // `render_and_push_console` di state.rs) — `Tokens.surface-
    // container-lowest` di bawah ini NILAINYA SENGAJA sama persis
    // (`#060e20`) dengan `terminus_dark().background`, supaya area
    // KOSONG (sel yang belum ketulisan apa-apa, TIDAK dapat "run" dari
    // `grid_to_plain_rows` — makanya kelihatan "background cuma
    // ngikutin teks" waktu warnanya beda dari container-nya, laporan
    // user yang kedua) nyambung mulus sewarna dengan background asli
    // sel yang KETULISAN. Independen total dari apa pun yang terjadi
    // di tab SSH manapun.
    background: Tokens.surface-container-lowest;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text != "") {
                if (event.text == "c") { ConsoleModel.console-input-requested("\u{3}"); return accept; }
                if (event.text == "d") { ConsoleModel.console-input-requested("\u{4}"); return accept; }
                if (event.text == "z") { ConsoleModel.console-input-requested("\u{1a}"); return accept; }
                if (event.text == "l") { ConsoleModel.console-input-requested("\u{c}"); return accept; }
                if (event.text == "a") { ConsoleModel.console-input-requested("\u{1}"); return accept; }
                if (event.text == "e") { ConsoleModel.console-input-requested("\u{5}"); return accept; }
                if (event.text == "u") { ConsoleModel.console-input-requested("\u{15}"); return accept; }
                if (event.text == "w") { ConsoleModel.console-input-requested("\u{17}"); return accept; }
                if (event.text == "r") { ConsoleModel.console-input-requested("\u{12}"); return accept; }
            }
            if (event.text == Key.Return) { ConsoleModel.console-input-requested("\u{d}"); return accept; }
            if (event.text == Key.Backspace) { ConsoleModel.console-input-requested("\u{7f}"); return accept; }
            if (event.text == Key.Tab) { ConsoleModel.console-input-requested("\u{9}"); return accept; }
            if (event.text == Key.Escape) { ConsoleModel.console-input-requested("\u{1b}"); return accept; }
            if (event.text == Key.UpArrow) { ConsoleModel.console-input-requested("\u{1b}[A"); return accept; }
            if (event.text == Key.DownArrow) { ConsoleModel.console-input-requested("\u{1b}[B"); return accept; }
            if (event.text == Key.RightArrow) { ConsoleModel.console-input-requested("\u{1b}[C"); return accept; }
            if (event.text == Key.LeftArrow) { ConsoleModel.console-input-requested("\u{1b}[D"); return accept; }
            if (event.text == Key.Delete) { ConsoleModel.console-input-requested("\u{1b}[3~"); return accept; }
            if (event.text == Key.Home) { ConsoleModel.console-input-requested("\u{1b}[H"); return accept; }
            if (event.text == Key.End) { ConsoleModel.console-input-requested("\u{1b}[F"); return accept; }
            ConsoleModel.console-input-requested(event.text);
            accept
        }

        init => { focus-scope.focus(); }
        TouchArea { clicked => { focus-scope.focus(); } }

        ScrollView {
            VerticalLayout {
                padding: Tokens.gutter-md;
                alignment: start;
                for r in ConsoleModel.rows : TerminalRowView { term-row: r; }
            }
        }
    }
}
