    fill: transparent;
    commands: "M3 6 h6 l2 2.5 h10 v10.5 a1 1 0 0 1 -1 1 h-16 a1 1 0 0 1 -1 -1 v-12 a1 1 0 0 1 1 -1 Z";
}

