import { Tokens } from "../tokens.slint";

// Ikon garis (line icon) monokrom — GANTI emoji berwarna (🖥/📁/⌨/📖/🗑)
// yang dipakai sebelumnya di sidebar & kartu host, atas permintaan
// eksplisit user ("ganti dengan icon line", "warnanya kurang jelas") —
// emoji punya warna BAWAAN sendiri (tidak bisa di-tint ikut tema
// aplikasi), makanya kelihatan tidak konsisten/kurang jelas di atas
// background gelap. Semua di sini murni `Path` bergaris (`fill:
// transparent`, cuma `stroke`), warnanya ikut `color` yang dioper
// caller (biasanya `Tokens.on-surface-variant`/`on-success-container`)
// — persis prinsip "line icon" (ikon outline satu warna).
export component IconServer inherits Path {
    in property <color> color: black;
    width: 100%;
    height: 100%;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.color;
    stroke-width: 1.8px;
    fill: transparent;
    commands: "M3 4 h18 a1 1 0 0 1 1 1 v4 a1 1 0 0 1 -1 1 h-18 a1 1 0 0 1 -1 -1 v-4 a1 1 0 0 1 1 -1 Z"
        + " M3 14 h18 a1 1 0 0 1 1 1 v4 a1 1 0 0 1 -1 1 h-18 a1 1 0 0 1 -1 -1 v-4 a1 1 0 0 1 1 -1 Z"
        + " M6.5 7.5 h.01 M6.5 17.5 h.01";
}

export component IconFolder inherits Path {
    in property <color> color: black;
    width: 100%;
    height: 100%;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.color;
    stroke-width: 1.8px;
